# Copy to .env and fill in. Never commit .env.
# development | production
APP_ENV=development
APP_URL=http://localhost:3400
# The development database started by: npm run db:start
DATABASE_URL=postgresql://outreach:outreach_dev@127.0.0.1:5544/outreach
# 32 random bytes, base64. Create with: npm run gen:key
TOKEN_ENCRYPTION_KEY=

# --- Gmail ---
# fake  = pretend Gmail stored in the database (development only)
# gmail = real Gmail API
EMAIL_TRANSPORT=fake
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Google console > Credentials > Authorised redirect URI: <APP_URL>/api/gmail/callback

# While the sandbox is on, every email goes to this inbox instead of the professor.
# It must stay on until APP_ENV=production.
EMAIL_SANDBOX=true
EMAIL_SANDBOX_TO=sandbox@example.test
# Real sending on this computer: EMAIL_SANDBOX=false together with EMAIL_REAL_LOCAL=true.
# Even then a campaign sends for real only after it was marked LIVE.
EMAIL_REAL_LOCAL=false
# Your own test addresses, separated by commas (at most ten). In test mode only these get their email themselves.
EMAIL_SANDBOX_ALLOW=
# all = every new Inbox message of connected students; professors = only professor conversations
INBOX_SCOPE=all
SYNC_SECONDS=120
# Professors' papers since 2010, from the free Crossref service: crossref | off
RESEARCH=crossref

# --- AI ---
# mock = no AI, fixed text (development only); groq; gemini; openai
LLM_PROVIDER=mock
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Checks the claims. Each Groq model has its own limit, so this does not slow the writer.
GROQ_CHECK_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=
# Real students are refused on the free Gemini tier
GEMINI_PAID_TIER=false
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_CONCURRENCY=4
LLM_RATE_PER_MIN=60
